<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox fx:id="startLayout" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.battleshipprojectp2p.GUI.startView.StartController">
    <!--      style="-fx-background-image:url(assets/BB61_USS_Iowa_BB61_broadside_USN.jpg)"-->

    <Button fx:id="hostStart" mnemonicParsing="false" onAction="#startHost" text="Start as Host" textFill="#3879bf">
        <HBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
        </HBox.margin>
    </Button>
    <Button fx:id="guestStart" mnemonicParsing="false" onAction="#startGuest" text="Start ast Guest" textFill="#3879bf">
        <HBox.margin>
            <Insets/>
        </HBox.margin>
    </Button>
</HBox>
