<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<VBox fx:id="startLayout" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.battleshipprojectp2p.GUI.startView.StartController"
>
    <VBox.margin>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </VBox.margin>
    <Button fx:id="hostStartButton" mnemonicParsing="false" onAction="#startHost" text="Start as Host"
            textFill="#3879bf"/>
    <Button fx:id="guestStartButton" mnemonicParsing="false" onAction="#startGuest" text="Start as Guest"
            textFill="#3879bf"/>
    <Button fx:id="closeButton" mnemonicParsing="false" onAction="#closeApp" text="Close" textFill="#3879bf"/>
</VBox>