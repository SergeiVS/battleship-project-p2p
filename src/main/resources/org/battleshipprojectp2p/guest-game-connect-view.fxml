            fx:controller="org.battleshipprojectp2p.GUI.gameConnectView.GuestGameConnectController">

    <Button fx:id="submitGuest" layoutX="281.0" layoutY="227.0" mnemonicParsing="false" onKeyTyped="#onSubmit"
            text="Enter game"/>
    <TextField fx:id="nameField" layoutX="287.0" layoutY="145.0"/>
    <Label layoutX="183.0" layoutY="149.0" text="Host IP"/>
    <Label layoutX="168.0" layoutY="97.0" text="Player name"/>
    <TextField fx:id="ipField" layoutX="287.0" layoutY="102.0"/>

</AnchorPane>
