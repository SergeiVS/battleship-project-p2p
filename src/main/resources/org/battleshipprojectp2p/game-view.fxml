<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.battleshipprojectp2p.GUI.gameView.GameViewController">
    <HBox alignment="CENTER" style="-fx-border-color: blue">
        <VBox fx:id="showBox">
        </VBox>
    </HBox>
    <HBox fx:id="buttonBar" alignment="BOTTOM_CENTER" prefHeight="38.0" prefWidth="125.0">
        <Button mnemonicParsing="false" text="Back to start" fx:id="backToStart" onAction="#onBackButtonClick"/>
        <Button mnemonicParsing="false" text="Button" fx:id="gameControlButton" onAction="#onGameControlClick"/>
    </HBox>
</VBox>