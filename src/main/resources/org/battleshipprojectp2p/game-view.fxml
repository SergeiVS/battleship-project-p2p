<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="gamePane" minHeight="-Infinity" minWidth="-Infinity" prefHeight="489.0" prefWidth="746.0"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.battleshipprojectp2p.GUI.gameView.GameViewController">
    <VBox fx:id="playerBox" layoutX="28.0" layoutY="51.0" prefHeight="318.0" prefWidth="213.0">
        <Label text="YOU"/>
        <Label fx:id="playerName" text="Label"/>
        <HBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </HBox.margin>
    </VBox>
    <VBox fx:id="opponentBox" layoutX="261.0" layoutY="51.0" prefHeight="336.0" prefWidth="199.0">
        <Label text="YOUR OPPONENT"/>
        <Label fx:id="opponentName" text="Label"/>
        <HBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </HBox.margin>
    </VBox>
    <VBox fx:id="setupBox" alignment="TOP_CENTER" layoutX="477.0" layoutY="51.0" prefHeight="459.0" prefWidth="300.0">
        <Label alignment="TOP_CENTER" contentDisplay="CENTER" text="Game SetUp"/>
        <HBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </HBox.margin>
    </VBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
</HBox>
